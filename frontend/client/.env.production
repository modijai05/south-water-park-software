# Production Environment Variables for Cloudflare Deployment
# South Water Park Ticket Management System
# Base name: thesouthticketmanagement

VITE_API_URL=/api
VITE_APP_NAME=South Water Park Ticket Management
VITE_APP_VERSION=1.0.0
VITE_ENVIRONMENT=production
VITE_DEBUG=false

# Cloudflare Deployment Configuration
# Frontend: Cloudflare Pages (thesouthticketmanagement.pages.dev)
# Backend: Render (south-water-park-backend.onrender.com)
# Database: MongoDB Atlas
# API Proxy: Cloudflare Worker for routing and CORS
